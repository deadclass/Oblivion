extends "res://tests/sandbox_checks.gd"

# Exercise the live InputMap/world dispatch as well as real physics and hit
# queries. These checks cover the control revision; retained sandbox checks
# separately cover ordinary movement, projectiles, platforms and the dummy.
func run(test_host) -> void:
	host = test_host
	world = load("res://main.tscn").instantiate()
	host.root.add_child(world)
	player = world.player
	dummy = world.dummy
	abilities = world.abilities
	player.test_control = true
	await host.tick(8)
	await test_layout_and_defence()
	await test_weapon_selection()
	await test_target_safety()
	await test_dash_motion()
	await test_dash_sword()
	await test_transient_resets()
	reset_joy()
	release_inputs()
	host.paused = false
	world.queue_free()
	await host.tick(2)
	completed = true

func reset_joy() -> void:
	for button in [JOY_BUTTON_A,JOY_BUTTON_B,JOY_BUTTON_X,JOY_BUTTON_Y,JOY_BUTTON_LEFT_SHOULDER,JOY_BUTTON_RIGHT_SHOULDER]:
		joy_button(button,false)
	for axis in [JOY_AXIS_LEFT_X,JOY_AXIS_LEFT_Y,JOY_AXIS_RIGHT_X,JOY_AXIS_RIGHT_Y,JOY_AXIS_TRIGGER_LEFT,JOY_AXIS_TRIGGER_RIGHT]:
		joy_axis(axis,0.0)

func live(point: Vector2 = Vector2(620,542)) -> void:
	reset_joy()
	await fixture(point)
	player.test_control = false
	await host.tick(3)

func test_layout_and_defence() -> void:
	await live()
	joy_button(JOY_BUTTON_A,true)
	await host.tick(3)
	check(player.jump_count==1 and not abilities.charging and abilities.active_time==0, "A/Cross jumps without starting melee or ranged")
	await host.tick(12)
	check(player.jump_count==1, "Holding the only jump button does not spend the air jump repeatedly")
	joy_button(JOY_BUTTON_A,false)
	await host.tick(2)
	joy_button(JOY_BUTTON_A,true)
	await host.tick(3)
	check(player.jump_count==2 and player.jumps_remaining==0, "A release and second press spends exactly the separate air jump")
	await live()
	joy_button(JOY_BUTTON_Y,true)
	await host.tick(3)
	check(player.jump_count==0 and abilities.selected_weapon==1, "Y/Triangle swaps weapon without jumping or attacking")
	await live()
	joy_button(JOY_BUTTON_X,true)
	await host.tick(3)
	check(player.jump_count==0 and abilities.active_move=="Sword slash" and not abilities.charging, "X/Square starts the fixed sword without jumping or starting ranged")
	await live()
	var origin: Vector2 = player.position
	joy_button(JOY_BUTTON_B,true)
	await host.tick(4)
	check(player.is_dodging and not player.rolling and not player.blocking and not abilities.charging, "B/Circle alone starts a neutral ground dodge rather than shield or ranged")
	await host.tick(12)
	check(player.position.distance_to(origin)<0.2, "Neutral ground dodge does not force horizontal movement")
	await host.tick(40)
	check(player.can_act() and not player.is_dodging, "Ground spot dodge completes and holding B cannot replay it")
	await live()
	joy_axis(JOY_AXIS_LEFT_X,1.0)
	joy_button(JOY_BUTTON_B,true)
	await host.tick(10)
	check(player.rolling and player.position.x>660 and not player.is_dashing, "Directional B rolls through physics independently of RB dash")
	await live()
	joy_axis(JOY_AXIS_LEFT_X,1.0)
	joy_button(JOY_BUTTON_LEFT_SHOULDER,true)
	await host.tick(8)
	check(player.blocking and not player.rolling and not player.is_dodging and absf(player.velocity.x)<0.1, "LB/L1 holds block despite directional stick input and never starts a roll")
	joy_button(JOY_BUTTON_RIGHT_SHOULDER,true)
	joy_button(JOY_BUTTON_B,true)
	await host.tick(4)
	check(player.blocking and not player.is_dashing and not player.is_dodging and not player.rolling, "Block excludes new dash and dodge even when their buttons are pressed together")
	await live()
	joy_axis(JOY_AXIS_TRIGGER_LEFT,1.0)
	await host.tick(25)
	check(world.aim.held and not player.blocking and not player.recovery_used and not abilities.move_spin and abilities.active_move.is_empty(), "Long-held LT/L2 aims without block, target cycling or the removed recovery spin")
	await live()
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.20)
	await host.tick(8)
	check(not abilities.charging and not player.blocking, "RT pressure below the 25 percent threshold is ignored and never blocks")
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.30)
	await host.tick(5)
	check(abilities.charging and not player.blocking, "RT/R2 just above its pressure threshold starts the selected Bow")
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	await host.tick(2)
	check(not abilities.charging and abilities.projectiles.size()==1, "Releasing RT pressure produces exactly one arrow")
	await live()
	key(KEY_Q,true)
	await host.tick(3)
	check(player.is_dodging and not player.blocking, "Keyboard Q routes to the independent dodge")
	await live()
	key(KEY_L,true)
	await host.tick(3)
	check(player.blocking and not player.is_dashing, "Keyboard L holds block independently of Shift dash")
	await live()
	key(KEY_SHIFT,true)
	await host.tick(3)
	check(player.is_dashing and not player.blocking, "Keyboard Shift starts dash and no longer holds block")
	await live()
	key(KEY_F,true)
	await host.tick(3)
	check(abilities.selected_weapon==1 and player.jump_count==0, "Keyboard F swaps the ranged loadout without movement leakage")

func test_weapon_selection() -> void:
	await live()
	check(abilities.selected_weapon==0 and abilities.selected_weapon_name()=="Bow", "Fresh training starts with the Bow selected")
	joy_button(JOY_BUTTON_Y,true)
	await host.tick(45)
	check(abilities.selected_weapon==1, "Holding Y swaps once rather than cycling every frame")
	joy_button(JOY_BUTTON_Y,false)
	await host.tick(2)
	joy_button(JOY_BUTTON_Y,true)
	await host.tick(3)
	check(abilities.selected_weapon==2 and abilities.selected_weapon_name()=="Bomb", "A second distinct Y press selects Bomb")
	joy_button(JOY_BUTTON_Y,false)
	await host.tick(2)
	joy_button(JOY_BUTTON_Y,true)
	await host.tick(3)
	check(abilities.selected_weapon==0, "The third Y press wraps Bomb back to Bow")
	await live(Vector2(950,542))
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(16)
	check(abilities.charging and abilities.charge_time>0.1, "Held RT charges Bow through the real world input dispatch")
	joy_button(JOY_BUTTON_Y,true)
	await host.tick(3)
	check(abilities.selected_weapon==1 and not abilities.charging and abilities.projectiles.is_empty() and abilities.ranged_requires_release, "Swapping during held Bow cancels charge without an arrow and latches ranged release")
	await host.tick(75)
	check(abilities.projectiles.is_empty() and not abilities.charging, "Keeping RT held after swap cannot automatically launch the replacement weapon")
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	joy_button(JOY_BUTTON_Y,false)
	await host.tick(3)
	check(not abilities.ranged_requires_release and abilities.projectiles.is_empty(), "RT release rearms the swapped loadout without leaking the cancelled arrow")
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(3)
	check(abilities.boomerang_active() and player.boomerang_form and not abilities.charging, "Fresh RT press transforms into the selected Boomerang")
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	await live(Vector2(950,542))
	await frozen_target(Vector2(1015,538))
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(10)
	joy_button(JOY_BUTTON_X,true)
	await host.tick(6)
	check(not abilities.charging and abilities._projectile_count("arrow")==0 and dummy.hit_count==1 and dummy.percent==5, "X interrupts a charging Bow for the same sword without firing an arrow")
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	await host.tick(25)
	check(abilities._projectile_count("arrow")==0 and dummy.hit_count==1, "Releasing RT after melee interruption cannot produce a delayed arrow")
	for selected in [1,2]:
		await live(Vector2(950,542))
		await frozen_target(Vector2(1015,538))
		abilities.selected_weapon = selected
		joy_button(JOY_BUTTON_X,true)
		await host.tick(6)
		check(dummy.hit_count==1 and dummy.percent==5 and abilities.selected_weapon==selected and abilities.projectiles.is_empty(), "The five-percent sword is unchanged with %s selected" % abilities.selected_weapon_name())
	await live(Vector2(950,542))
	abilities.selected_weapon = 2
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(3)
	var placed = abilities.orb
	check(is_instance_valid(placed) and dummy.hit_count==0, "Selected Bomb deploys from RT without initial target damage")
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	joy_button(JOY_BUTTON_Y,true)
	await host.tick(5)
	check(abilities.selected_weapon==0 and is_instance_valid(placed) and abilities.orb==placed, "Switching away from Bomb preserves the live bomb")
	joy_button(JOY_BUTTON_Y,false)
	await host.tick(45)
	await frozen_target(Vector2(1015,538))
	joy_button(JOY_BUTTON_X,true)
	await host.tick(6)
	check(dummy.hit_count==1 and dummy.percent==5 and is_instance_valid(placed), "The unchanged sword still hits while a switched-away bomb remains active")
	await live(Vector2(950,542))
	abilities.selected_weapon = 1
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(2)
	var throw = abilities.boomerang
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	joy_button(JOY_BUTTON_Y,true)
	await host.tick(3)
	check(is_instance_valid(throw) and throw.kind=="crescent" and player.boomerang_form, "Loadout input during the returning form cannot discard or duplicate the live transformation")
	await live()
	joy_axis(JOY_AXIS_LEFT_Y,-1.0)
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(5)
	check(abilities.selected_weapon==0 and abilities.charging and not abilities.move_spin and not player.recovery_used, "Up plus RT charges the selected Bow instead of selecting a recovery ability")
	await live()
	abilities.selected_weapon = 1
	joy_axis(JOY_AXIS_LEFT_Y,1.0)
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(3)
	check(abilities.boomerang_active() and not is_instance_valid(abilities.orb), "Down plus RT keeps Boomerang form selected instead of choosing Bomb")
	await live(Vector2(950,542))
	abilities.selected_weapon = 2
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(3)
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	await host.tick(45)
	await frozen_target(Vector2(1080,538))
	abilities.orb.position = Vector2(1040,538)
	abilities.orb.velocity = Vector2.ZERO
	abilities.orb.settled = true
	await host.tick(2)
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(2)
	check(dummy.hit_count==1 and dummy.percent==14 and not is_instance_valid(abilities.orb), "A second fresh RT press with Bomb selected detonates its existing live bomb")

func test_target_safety() -> void:
	await live()
	check(world.targets.size()==4 and world.selected_target()==null, "Training retains four inert targets and starts with free ranged aim")
	Input.action_press("target")
	await host.tick(3)
	world.respawn()
	check(not world.aim.held, "Player reset releases transient aim rather than retaining a locked target")
	await host.tick(5)
	for target in world.targets:
		target.accept_hit(5,Vector2.ZERO,"Reset selection fixture")
	world.reset_dummy()
	var all_clear: bool = true
	for target in world.targets:
		all_clear = all_clear and target.percent==0 and target.hit_count==0
	check(all_clear and not world.aim.held, "Dummy reset clears all four targets' results and releases transient aim")
	world.reset_room()
	check(world.selected_target()==null and abilities.selected_weapon==0 and not world.aim.held, "Full reset restores Bow and free ranged aim without a target lock")
	await live()
	joy_axis(JOY_AXIS_LEFT_X,-1.0)
	joy_button(JOY_BUTTON_RIGHT_SHOULDER,true)
	await host.tick(3)
	check(player.is_dashing and player.dash_direction==Vector2.LEFT, "Dash follows movement stick independently of nearby practice targets")

func test_dash_motion() -> void:
	await fixture(Vector2(620,542))
	check(player.request_dash(Vector2(0,-1)) and player.dash_direction==Vector2.RIGHT, "Neutral horizontal ground dash ignores upward aim and uses facing")
	var origin: Vector2 = player.position
	await host.tick(10)
	check(player.is_dashing and player.position.x>origin.x+45 and absf(player.position.y-origin.y)<0.5, "Ground dash travels horizontally at committed speed through physics")
	check(not player.request_dash(Vector2.LEFT), "An active dash cannot stack another dash")
	await host.tick(30)
	check(not player.is_dashing and not player.request_dash(Vector2.RIGHT), "Dash motion ends before its cooldown permits another dash")
	await host.tick(35)
	check(player.can_act() and player.request_dash(Vector2(-0.6,1)), "Expired ground cooldown permits a fresh left dash regardless of downward aim")
	check(player.dash_direction==Vector2.LEFT and player.facing==-1, "Left ground dash fixes both direction and facing")
	await fixture(Vector2(620,-150))
	var aim := Vector2(0.8,-0.3)
	var jumps_before: int = player.jumps_remaining
	check(player.request_dash(aim), "Air dash accepts an arbitrary analog stick angle")
	check(player.dash_direction.is_equal_approx(aim.normalized()) and absf(player.velocity.length()-560)<0.1, "Air dash keeps the full stick angle and normalizes diagonal speed")
	origin = player.position
	await host.tick(10)
	check(player.position.x>origin.x+40 and player.position.y<origin.y-10, "Non-cardinal air dash physically follows both components of its analog heading")
	check(not player.dash_available and player.dodge_available and player.jumps_remaining==jumps_before, "Air dash spends its own resource while retaining air dodge and available jumps")
	await host.tick(75)
	check(not player.request_dash(Vector2.UP), "Waiting out cooldown alone cannot restore a consumed air dash before landing")
	await host.tick(250)
	check(player.is_on_floor() and player.dash_available and player.request_dash(Vector2.LEFT), "Actual landing restores the air-dash resource")
	await fixture(Vector2(620,120))
	player.facing = -1
	check(player.request_dash(Vector2.ZERO) and player.dash_direction==Vector2.LEFT, "Neutral airborne dash falls back to current facing")
	await fixture(Vector2(620,120))
	check(player.request_dash(Vector2.DOWN) and player.dash_direction==Vector2.DOWN and absf(player.velocity.y-560)<0.1, "Air dash supports straight down without increasing normalized speed")
	await fixture(Vector2(620,120))
	check(player.request_dash(Vector2.UP) and player.dash_direction==Vector2.UP and player.velocity.y==-560, "Air dash supports straight up without the removed spin recovery")
	await fixture()
	player.test_block_held = true
	check(not player.request_dash(Vector2.RIGHT), "A newly requested block excludes dash before the player physics node ticks")
	await fixture()
	check(player.request_dodge(Vector2.RIGHT) and not player.request_dash(Vector2.RIGHT), "Committed roll excludes dash")
	await fixture()
	check(player.request_dash(Vector2.RIGHT) and not player.request_dodge(Vector2.RIGHT), "Committed dash excludes dodge")
	await fixture(Vector2(3170,542))
	player.request_dash(Vector2.RIGHT)
	await host.tick(15)
	check(player.position.x<=3189.2, "Ground dash respects the arena's solid edge wall")
	await live()
	joy_button(JOY_BUTTON_RIGHT_SHOULDER,true)
	await host.tick(4)
	check(player.is_dashing and not player.blocking and not player.is_dodging, "Actual RB/R1 routes to dash rather than block or dodge")
	await host.tick(100)
	check(not player.is_dashing and player.dash_cooldown==0, "Holding RB does not repeat dash when its cooldown expires")

func press_dash_sword(dash_first: bool, separation: int = 0) -> void:
	joy_button(JOY_BUTTON_RIGHT_SHOULDER if dash_first else JOY_BUTTON_X,true)
	if separation>0:
		await host.tick(separation)
	joy_button(JOY_BUTTON_X if dash_first else JOY_BUTTON_RIGHT_SHOULDER,true)
	await host.tick(2)

func test_dash_sword() -> void:
	await live(Vector2(950,542))
	await frozen_target(Vector2(1015,538))
	joy_button(JOY_BUTTON_RIGHT_SHOULDER,true)
	await host.tick(25)
	check(dummy.hit_count==0 and dummy.percent==0, "Plain dash passes the target without dealing sword damage")
	await live(Vector2(950,542))
	await frozen_target(Vector2(1015,538))
	await press_dash_sword(true)
	check(abilities.move_dash and dummy.hit_count==1 and dummy.percent==8 and dummy.last_move=="Sword dash", "Simultaneous RB plus X produces one eight-percent sword dash through real input and collision")
	await host.tick(30)
	check(dummy.hit_count==1 and dummy.percent==8, "Sword dash's moving persistent volume hits the same target only once")
	await live(Vector2(950,542))
	await frozen_target(Vector2(1095,538))
	await press_dash_sword(true,3)
	check(abilities.move_dash and player.is_dashing, "Dash then melee within 80 ms upgrades the active movement to sword dash")
	await host.tick(22)
	check(dummy.hit_count==1 and dummy.percent==8, "Sword dash hit volume travels with the player to a target beyond initial sword reach")
	await live(Vector2(950,542))
	await frozen_target(Vector2(1110,538))
	await press_dash_sword(false,3)
	check(abilities.move_dash and player.is_dashing, "Melee then dash within 80 ms produces the same sword-dash chord")
	await host.tick(22)
	check(dummy.hit_count==1 and dummy.percent==8, "Melee-first chord strikes the later target once with sword-dash damage")
	await live(Vector2(950,542))
	await frozen_target(Vector2(1015,538))
	await press_dash_sword(false,1)
	await host.tick(25)
	check(abilities.move_dash and dummy.hit_count==1 and dummy.percent==5, "Melee-first chord queues across hitstop and upgrades without a second hit on the same target")
	await live()
	await press_dash_sword(true,9)
	check(abilities.move_dash, "Dash-first chord remains accepted at 75 ms just inside the chord window")
	await live()
	await press_dash_sword(false,9)
	check(abilities.move_dash, "Melee-first chord remains accepted at 75 ms just inside the chord window")
	await live()
	await press_dash_sword(true,10)
	check(not abilities.move_dash, "Dash then melee outside the 80 ms window cannot become a delayed sword dash")
	await live()
	await press_dash_sword(false,10)
	check(not abilities.move_dash, "Melee then dash outside the 80 ms window cannot upgrade the expired sword")
	await live(Vector2(950,542))
	await frozen_target(Vector2(1015,538))
	abilities.selected_weapon = 2
	await press_dash_sword(true)
	check(dummy.hit_count==1 and dummy.percent==8 and abilities.selected_weapon==2 and not is_instance_valid(abilities.orb), "Sword-dash chord remains the same sword when Bomb is selected")
	await live(Vector2(950,542))
	await frozen_target(Vector2(890,538))
	await press_dash_sword(true)
	await host.tick(20)
	check(dummy.hit_count==0, "Sword dash cannot hit the target behind its committed heading")
	await live(Vector2(950,542))
	await frozen_target(Vector2(1030,538))
	var wall = world.make_surface(Rect2(995,450,10,110),false)
	await host.tick(2)
	await press_dash_sword(true)
	await host.tick(25)
	check(dummy.hit_count==0 and player.position.x<985, "Sword dash respects solid-wall line of sight and physical movement collision")
	wall.queue_free()
	await host.tick(2)
	await live(Vector2(950,270))
	joy_axis(JOY_AXIS_LEFT_X,0.8)
	joy_axis(JOY_AXIS_LEFT_Y,-0.3)
	await frozen_target(player.position+Vector2(0.8,-0.3).normalized()*72)
	await press_dash_sword(true)
	check(abilities.move_dash and abilities.move_direction.is_equal_approx(player.dash_direction) and dummy.hit_count==1 and dummy.percent==8, "Air sword-dash volume rotates into the same full analog heading as movement")

func test_transient_resets() -> void:
	await live()
	abilities.selected_weapon = 2
	world.respawn()
	check(abilities.selected_weapon==2 and not player.is_dashing and player.dash_available, "Player reset preserves selection while restoring dash resources")
	await host.tick(5)
	world.reset_dummy()
	check(abilities.selected_weapon==2, "Dummy reset preserves the selected ranged weapon")
	world.reset_room()
	check(abilities.selected_weapon==0 and abilities.selected_weapon_name()=="Bow", "Full room reset explicitly restores the initial Bow loadout")
	await live(Vector2(950,542))
	await press_dash_sword(true)
	world.pause_game()
	check(host.paused and not player.is_dashing and abilities.active_time==0 and not abilities.move_dash, "Pause cancels both dash motion and sword-dash hit volume immediately")
	var before: Vector2 = player.position
	await host.tick(20)
	check(player.position==before, "Paused dash cannot drift or hit while the scene is paused")
	world.ui_canvas.get_node("Pause").resume()
	await host.tick(20)
	check(not player.is_dashing and not abilities.move_dash and not abilities.charging, "Resume does not replay the held dash/melee chord or any queued ranged action")
	await live(Vector2(620,100))
	joy_button(JOY_BUTTON_RIGHT_SHOULDER,true)
	await host.tick(2)
	world.controls.use_controller(31,"Xbox Controller")
	world.controls.on_connection_changed(31,false)
	check(host.paused and not player.is_dashing and not player.dash_available, "Controller unplug cancels an air dash without granting another airborne use")
	world.ui_canvas.get_node("Pause").resume()
	await host.tick(12)
	check(not player.is_dashing and not abilities.move_dash and not Input.is_action_pressed("dash"), "Unplug resume clears held dash instead of replaying it")
	await live(Vector2(950,542))
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,1.0)
	await host.tick(8)
	world.respawn()
	joy_axis(JOY_AXIS_TRIGGER_RIGHT,0.0)
	await host.tick(15)
	check(not abilities.charging and abilities.projectiles.is_empty(), "Player reset cancels held ranged charge without a later release arrow")
	await live(Vector2(950,542))
	await frozen_target(Vector2(1110,538))
	await press_dash_sword(true)
	world.reset_dummy()
	await host.tick(20)
	check(not player.is_dashing and not abilities.move_dash and dummy.hit_count==0, "Dummy reset cancels a moving sword dash before it can strike after reset")
